{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AEO Fixture Evidence Desk",
  "version": "0.0.2",
  "identifier": "com.assignment.aeo-fixture-evidence-desk",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AEO Fixture Evidence Desk",
        "width": 1180,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'"
    }
  },
  "bundle": {
    "active": true
  }
}
